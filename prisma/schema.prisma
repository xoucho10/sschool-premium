generator client { provider = "prisma-client-js" }
datasource db { provider = "mysql" url = env("DATABASE_URL") }
model Student { id String @id @default(cuid()); admissionNo String @unique; firstName String; lastName String; classId String; parentId String?; feesBalance Float @default(0); createdAt DateTime @default(now()); class Class @relation(fields: [classId], references: [id]); parent Parent? @relation(fields: [parentId], references: [id]) }
model Parent { id String @id @default(cuid()); name String; phone String @unique; email String?; students Student[] }
model Teacher { id String @id @default(cuid()); name String; email String @unique; subject String; students Result[] }
model Class { id String @id @default(cuid()); name String @unique; students Student[] }
model Subject { id String @id @default(cuid()); name String; code String @unique; results Result[] }
model Result { id String @id @default(cuid()); studentId String; subjectId String; teacherId String; term String; year Int; score Float; grade String; subject Subject @relation(fields: [subjectId], references: [id]); teacher Teacher @relation(fields: [teacherId], references: [id]) }
model News { id String @id @default(cuid()); title String; content String @db.Text; createdAt DateTime @default(now()) }
model Application { id String @id @default(cuid()); name String; phone String; classApplying String; status String @default("pending"); createdAt DateTime @default(now()) }
model User { id String @id @default(cuid()); email String @unique; password String; role String; name String }
